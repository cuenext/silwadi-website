# Production static website only; stage and test before the October 6 cutover.
# Merge into the existing .htaccess. Preserve preview Basic Auth and cPanel SSL rules.
# This is NOT the booking API configuration.
Options -Indexes -MultiViews

<FilesMatch "(^\.|\.(?:env|pem|key|p12|pfx|sql|sqlite|sqlite3|db|bak|backup|log|ini|sh|py|yml|yaml|php)$)">
    Require all denied
</FilesMatch>

# Required: mod_headers. Do not silently omit these protections.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

# Observe a stricter policy in browser developer tools before enforcing it.
# No report endpoint is configured: no patient URLs or details are transmitted.
Header always set Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://booking.silwadi.ae; media-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"

# Permanently consolidate public-site HTTP and www URLs on the HTTPS apex.
# Scope these rules to the public site hosts; booking and preview stay separate.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^silwadi\.ae$ [OR]
RewriteCond %{HTTP_HOST} ^www\.silwadi\.ae$
RewriteRule ^locations\/contact\.html$ "https\:\/\/silwadi\.ae\/contact\.html" [R=301,L]

RewriteCond %{HTTP_HOST} ^(?:www\.)?silwadi\.ae$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.silwadi\.ae$ [NC]
# Keep the original percent-encoded path; the query string passes through.
RewriteCond %{THE_REQUEST} \s(/[^\s?]*)
RewriteRule ^ https://silwadi.ae%1 [R=301,L,NE]

# HSTS deliberately waits for successful cutover and stable HTTPS.
